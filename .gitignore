# === Private Dataset & Annotations ===
# Never commit competition data or derived private artifacts
1st-krones-vision-ai-challenge/
train_images/
test_images/
train_annotations.json
train.csv
sample_submission.csv
*.zip
*.tar.gz

# Allow synthetic test fixtures
!tests/
!tests/fixtures/
!tests/fixtures/synthetic_dataset/
!tests/fixtures/synthetic_dataset/**
!tests/fixtures/synthetic_dataset/train_images/
!tests/fixtures/synthetic_dataset/train_images/**
!tests/fixtures/synthetic_dataset/test_images/
!tests/fixtures/synthetic_dataset/test_images/**
!tests/fixtures/synthetic_dataset/train.csv
!tests/fixtures/synthetic_dataset/sample_submission.csv
!tests/fixtures/synthetic_dataset/train_annotations.json


# === Generated Output Categories ===
# Allow .gitkeep to track empty output directories, but ignore generated contents
outputs/models/*
!outputs/models/.gitkeep

outputs/predictions/*
!outputs/predictions/.gitkeep

outputs/figures/*
!outputs/figures/.gitkeep

outputs/reports/*
!outputs/reports/.gitkeep

outputs/submissions/*
!outputs/submissions/.gitkeep

outputs/hard_examples/*
!outputs/hard_examples/.gitkeep

# Also ignore any stray files directly in outputs/
outputs/*
!outputs/.gitkeep

